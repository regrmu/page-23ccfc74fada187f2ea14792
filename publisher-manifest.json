t-decoration: none;padding: 0.52rem 0.78rem;border: 2px dashed var(--ivory-soft);background: transparent;font-size: 0.94rem;transition: background-color 160ms ease, color 160ms ease}\n\n.jump a:hover {background: var(--ivory);color: var(--wine)}\n\n.section {max-width: 1220px;margin: 0 auto;padding: clamp(3.5rem, 7vw, 6rem) clamp(1rem, 4vw, 2.25rem)}\n\n.eyebrow {margin: 0;color: var(--wine);font-size: 0.92rem;font-weight: 800;letter-spacing: 0.18em}\n\n.section h2 {margin: 0.55rem 0 0.8rem;max-width: 760px;font-size: clamp(1.9rem, 4.3vw, 3.1rem);line-height: 1.04;letter-spacing: -0.045em}\n\n.lead {max-width: 62rem;margin: 0;color: var(--muted);font-size: 1.04rem}\n\n.section-bottom-link {display: inline-block;margin-top: 1.5rem;padding: 0.55rem 0.85rem;border: 2px dashed var(--soft);text-decoration: none;color: var(--wine);background: var(--paper)}\n\n.steps {list-style: none;padding: 0;margin: 2.1rem 0 0;display: grid;gap: 1rem}\n\n.steps li {display: grid;grid-template-columns: 72px minmax(0, 1fr);gap: 1rem;align-items: start}\n\n.step-num {display: inline-flex;align-items: center;justify-content: center;min-height: 56px;padding: 0.5rem 0.55rem;border: 2px dashed var(--line);color: var(--wine);background: var(--paper);font-size: 1.3rem;font-weight: 800}\n\n.steps h3 {margin: 0 0 0.35rem;font-size: 1.16rem;letter-spacing: -0.02em}\n\n.steps p {margin: 0;color: var(--muted)}\n\n.ticket {position: relative;border: 2px dashed var(--wine);background: var(--paper);padding: clamp(1rem, 3vw, 1.5rem)}\n\n.ticket::before {content: \"\";position: absolute;inset: 0.35rem;border: 1px dashed rgba(95, 16, 32, 0.14);pointer-events: none}\n\n.ticket > * {position: relative}\n\n.ticket-head {display: flex;flex-wrap: wrap;justify-content: space-between;align-items: center;gap: 0.75rem;border-bottom: 2px dashed rgba(95, 16, 32, 0.22);padding-bottom: 0.85rem;margin-bottom: 1rem}\n\n.ticket-head h3 {margin: 0;font-size: 1.32rem;letter-spacing: -0.03em}\n\n.badge {display: inline-block;padding: 0.22rem 0.55rem;background: var(--wine);color: var(--ivory);border: 1px dashed var(--ivory);font-size: 0.8rem;font-weight: 700}\n\n.price {display: flex;flex-wrap: wrap;gap: 0.6rem 1rem;align-items: baseline;margin: 0 0 1rem;color: var(--muted)}\n\n.price strong {color: var(--wine);font-size: 1.55rem;letter-spacing: -0.035em}\n\n.features {list-style: none;margin: 0 0 1rem;padding: 0;display: grid;gap: 0.55rem}\n\n.features li {position: relative;padding-left: 1.45rem;color: #2a1116}\n\n.features li::before {content: \"□\";position: absolute;left: 0;top: 0;color: var(--wine)}\n\n.footnote {margin: 0;color: var(--muted);font-size: 0.94rem}\n\n.stairs {list-style: none;padding: 0;margin: 2.1rem 0 0;display: grid;gap: 1.15rem}\n\n.price-note {margin-top: 1.5rem}\n\n.price-note h3 {margin: 0 0 0.8rem;font-size: 1.2rem}\n\n.check {list-style: none;padding: 0;margin: 1.15rem 0 0;display: grid;gap: 0.8rem}\n\n.check li {position: relative;padding-left: 1.55rem}\n\n.check li::before {content: \"—\";position: absolute;left: 0;top: 0;color: var(--wine);font-weight: 800}\n\n.check p {margin: 0}\n\n.device-grid {display: grid;gap: 1rem;margin-top: 1.25rem}\n\n.device {padding: 1rem;border: 2px dashed var(--soft);background: rgba(255, 253, 246, 0.86)}\n\n.device h3 {margin: 0 0 0.45rem;color: var(--wine);font-size: 1.06rem}\n\n.device p {margin: 0;color: var(--muted);font-size: 0.96rem}\n\n.faq-groups {display: grid;gap: 1.25rem;margin-top: 2.1rem}\n\n.faq-group {padding: 1.15rem;border: 2px dashed var(--line);background: var(--paper)}\n\n.faq-group h3 {margin: 0 0 0.8rem;font-size: 1.24rem;letter-spacing: -0.03em}\n\n.faq-list {display: grid;gap: 0.75rem}\n\ndetails {border-top: 1px dashed rgba(95, 16, 32, 0.28);padding-top: 0.85rem}\n\nsummary {position: relative;list-style: none;padding-left: 1.55rem;color: var(--wine);font-weight: 800;cursor: pointer}\n\nsummary::-webkit-details-marker {display: none}\n\nsummary::before {content: \"＋\";position: absolute;left: 0;top: 0;font-weight: 800}\n\ndetails[open] summary::before {content: \"－\"}\n\ndetails p {margin: 0.55rem 0 0;color: var(--muted)}\n\n.notice {background: var(--wine-deep);color: var(--ivory)}\n\n.notice-inner {max-width: 1220px;margin: 0 auto;padding: clamp(3.5rem, 7vw, 6rem) clamp(1rem, 4vw, 2.25rem)}\n\n.notice .eyebrow {color: #f0c7b6}\n\n.notice h2 {color: var(--ivory)}\n\n.notice-list {list-style: none;margin: 2rem 0 0;padding: 0;display: grid;gap: 0.9rem}\n\n.notice-list li {position: relative;padding-left: 1.5rem;border-left: 2px dashed var(--ivory-soft);color: #f5d6c7}\n\n.notice-list li::before {content: \"\";position: absolute;left: -0.25rem;top: 0.82rem;width: 0.55rem;height: 2px;background: #f0c7b6}\n\n.back-link {display: inline-block;margin-top: 1.7rem;padding: 0.55rem 0.85rem;color: var(--ivory);border: 2px dashed var(--ivory-soft);text-decoration: none}\n\n@media (max-width: 719px) {\n  .hero-grid {grid-template-columns: 1fr}\n\n  .steps li {grid-template-columns: 56px minmax(0, 1fr);gap: 0.7rem}\n\n  .step-num {min-height: 48px;font-size: 1.1rem}\n}\n\n@media (min-width: 760px) {\n  .hero-grid {grid-template-columns: repeat(12, minmax(0, 1fr))}\n\n  .panel.a {grid-column: 1 / span 5}\n\n  .panel.b {grid-column: 6 / span 4}\n\n  .panel.c {grid-column: 10 / span 3}\n\n  .panel.d {grid-column: 2 / span 4}\n\n  .panel.e {grid-column: 6 / span 7}\n\n  .device-grid {grid-template-columns: repeat(3, minmax(0, 1fr))}\n}\n\n@media (min-width: 920px) {\n  .stairs {display: block}\n\n  .stairs > li {width: 72%;margin-left: 0;margin-bottom: 1.35rem}\n\n  .stairs > li.plan-b {width: 86%;margin-left: 8%}\n\n  .stairs > li.plan-c {width: 100%;margin-left: 16%}\n}\n</style><main>\n<section id=\"top\" class=\"hero\">\n  <div class=\"hero-inner\">\n    <div class=\"brand-mark\">品牌信息页</div>\n    <h1>小米Cloud 套餐与设备准备清单</h1>\n    <p class=\"hero-lede\">这一页不按广告写，而按清单写：先看参考套餐，再看设备数量、使用步骤和常见问题。价格与权益来自已提供的参考套餐，实际开通以真实渠道为准。</p>\n\n    <div class=\"hero-grid\" aria-label=\"小米Cloud 信息速览\">\n      <div class=\"panel a\">\n        <span class=\"panel-label\">参考套餐</span>\n        <span class=\"panel-value\">3 档</span>\n        <span class=\"panel-note\">基础版、旗舰版、团队版依次递进。</span>\n      </div>\n      <div class=\"panel b\">\n        <span class=\"panel-label\">设备数量</span>\n        <span class=\"panel-value\">3–20</span>\n        <span class=\"panel-note\">分别支持 3、5、20 台设备同时在线。</span>\n      </div>\n      <div class=\"panel c\">\n        <span class=\"panel-label\">流量额度</span>\n        <span class=\"panel-value\">100–1000</span>\n        <span class=\"panel-note\">单位为 GB / 月。</span>\n      </div>\n      <div class=\"panel d\">\n        <span class=\"panel-label\">年付选项</span>\n        <span class=\"panel-value\">3 档</span>\n        <span class=\"panel-note\">基础 ¥150、旗舰 ¥350、团队 ¥850。</span>\n      </div>\n      <div class=\"panel e\">\n        <span class=\"panel-label\">本页结构</span>\n        <span class=\"panel-value\">5 个区块</span>\n        <span class=\"panel-note\">使用步骤、套餐清单、客户端准备、常见问题、信息边界。</span>\n      </div>\n    </div>\n\n    <div class=\"jump\">\n      <a href=\"#steps\">使用步骤</a>\n      <a href=\"#plans\">套餐清单</a>\n      <a href=\"#clients\">客户端准备</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#notice\">信息边界</a>\n    </div>\n  </div>\n</section>\n\n<section id=\"steps\" class=\"section\">\n  <p class=\"eyebrow\">01 使用步骤</p>\n  <h2>先确认设备，再看套餐，最后导入配置</h2>\n  <p class=\"lead\">不要先找花哨入口。按下面三步做，能少走弯路：先算设备，再选流量，最后从可靠渠道获取配置并测试。</p>\n\n  <ol class=\"steps\">\n    <li>\n      <span class=\"step-num\">01</span>\n      <div>\n        <h3>确认使用场景</h3>\n        <p>把需要长期在线的设备列出来：电脑、手机、平板、电视盒子或路由器。单人一机可先看基础版；多人多机可看旗舰版；团队统一接入可看团队版。</p>\n      </div>\n    </li>\n    <li>\n      <span class=\"step-num\">02</span>\n      <div>\n        <h3>比较流量和权益</h3>\n        <p>流量额度决定月度容量，设备数量决定并发在线，线路与工单权益决定不同场景下的支持方式。选择时不要只看价格，要把使用强度一起放在一起判断。</p>\n      </div>\n    </li>\n    <li>\n      <span class=\"step-num\">03</span>\n      <div>\n        <h3>获取配置并测试</h3>\n        <p>从实际开通页面或可靠渠道获取安装包、配置文件或账号说明。本页不放置未经确认的下载入口。首次使用时分别测试网页、在线文档、视频平台和应用更新，并记录哪个场景正常或异常。</p>\n      </div>\n    </li>\n  </ol>\n\n  <a class=\"section-bottom-link\" href=\"#plans\">跳到套餐清单</a>\n</section>\n\n<section id=\"plans\" class=\"section\">\n  <p class=\"eyebrow\">02 套餐清单</p>\n  <h2>三档套餐按设备与容量递进</h2>\n  <p class=\"lead\">以下套餐按参考信息整理。月付与年付都列在同一张票式卡片里，方便先看价格，再看权益，最后判断年付是否值得。</p>\n\n  <ol class=\"stairs\">\n    <li class=\"ticket plan-a\">\n      <div class=\"ticket-head\">\n        <h3>基础版</h3>\n        <span class=\"badge\">入门</span>\n      </div>\n      <p class=\"price\"><strong>¥15/月</strong><span>年付 ¥150/年</span></p>\n      <ul class=\"features\">\n        <li>每月 100GB 流量额度</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>基础流媒体权益</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <p class=\"footnote\">适合单人、少设备、日常网页与文档为主的轻度使用。</p>\n    </li>\n\n    <li class=\"ticket plan-b\">\n      <div class=\"ticket-head\">\n        <h3>旗舰版</h3>\n        <span class=\"badge\">参考优先</span>\n      </div>\n      <p class=\"price\"><strong>¥35/月</strong><span>年付 ¥350/年</span></p>\n      <ul class=\"features\">\n        <li>每月 300GB 流量额度</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>多节点常见流媒体权益</li>\n        <li>专线游戏线路优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <p class=\"footnote\">适合家庭、小型工作室或多终端用户，容量和工单支持更完整。</p>\n    </li>\n\n    <li class=\"ticket plan-c\">\n      <div class=\"ticket-head\">\n        <h3>团队版</h3>\n        <span class=\"badge\">团队</span>\n      </div>\n      <p class=\"price\"><strong>¥85/月</strong><span>年付 ¥850/年</span></p>\n      <ul class=\"features\">\n        <li>每月 1000GB 流量额度</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>专属团队节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理支持</li>\n      </ul>\n      <p class=\"footnote\">适合多人集中接入、需要更高容量和更明确沟通窗口的团队。</p>\n    </li>\n  </ol>\n\n  <div class=\"ticket price-note\">\n    <h3>选择年付还是月付</h3>\n    <ul class=\"check\">\n      <li>若每个月都会使用，基础版年付 ¥150 低于 12 个月月付合计 ¥180；旗舰版年付 ¥350 低于 12 个月月付合计 ¥420；团队版年付 ¥850 低于 12 个月月付合计 ¥1020。</li>\n      <li>若使用周期还不确定，先选择月付更稳妥，等确认设备数量和常用场景后再考虑年付。</li>\n      <li>开通前确认年付权益是否与月付一致，尤其是流量额度、设备数量和线路支持方式。</li>\n    </ul>\n  </div>\n</section>\n\n<section id=\"clients\" class=\"section\">\n  <p class=\"eyebrow\">03 客户端准备</p>\n  <h2>没有可确认直链时，先把设备准备好</h2>\n  <p class=\"lead\">当前可确认信息不足以列出官方下载直链，因此本页不展示未经确认的安装地址。可以先按下面的设备清单做准备，开通时再使用实际渠道提供的入口。</p>\n\n  <div class=\"ticket\">\n    <h3>准备清单</h3>\n    <ul class=\"check\">\n      <li>从实际开通页面获取账号、配置文件或安装包，不把第三方来源当作可靠入口。</li>\n      <li>先在一台主要设备完成配置，确认能正常访问常用场景，再扩展到更多设备。</li>\n      <li>如果计划使用路由器或共享网络，先确认该设备是否适合导入配置，并保留普通网络作为备用。</li>\n      <li>测试时记录时间、设备、网络和平台，方便后续向支持渠道说明情况。</li>\n    </ul>\n\n    <div class=\"device-grid\">\n      <article class=\"device\">\n        <h3>桌面端</h3>\n        <p>如果实际渠道提供桌面端，一般可在安装后导入配置或登录账号，再按照说明启用系统网络设置。</p>\n      </article>\n      <article class=\"device\">\n        <h3>移动端</h3>\n        <p>如果实际渠道提供移动端入口，优先从开通页给出的方式获取，避免同时在一台手机上堆积多个未知来源配置。</p>\n      </article>\n      <article class=\"device\">\n        <h3>路由或共享设备</h3>\n        <p>路由器适合集中管理，但配置更复杂。首次测试建议先从单台终端开始，再考虑共享网络。</p>\n      </article>\n    </div>\n  </div>\n\n  <a class=\"section-bottom-link\" href=\"#faq\">查看常见问题</a>\n</section>\n\n<section id=\"faq\" class=\"section\">\n  <p class=\"eyebrow\">04 常见问题</p>\n  <h2>按开通前、使用中和费用查看</h2>\n  <p class=\"lead\">下面的问答只回答当前页面能说明的内容。未展示的授权关系、售后条款和兼容性列表，请回到实际开通页面确认。</p>\n\n  <div class=\"faq-groups\">\n    <section class=\"faq-group\">\n      <h3>开通前</h3>\n      <div class=\"faq-list\">\n        <details>\n          <summary>应该先看流量还是先看设备数？</summary>\n          <p>先看设备数，再估流量。参考套餐中的设备数分别为 3、5、20 台，月流量额度分别为 100、300、1000GB。如果只有一两台设备且以网页和文档为主，可以从基础版开始；如果多设备并发，优先看旗舰版或团队版。</p>\n        </details>\n        <details>\n          <summary>三档套餐最容易忽略的差异是什么？</summary>\n          <p>除了流量，还要看同时在线设备数和线路支持方式。基础版偏个人入门，旗舰版增加多设备与专线游戏线路优化，团队版面向更高容量和企业路由场景。价格接近时，使用场景比价格更重要。</p>\n        </details>\n        <details>\n          <summary>页面里为什么没有下载链接？</summary>\n          <p>因为没有可靠来源的下载直链，所以本页不放置未确认链接。实际安装入口应以开通页面、购买页或明确提供配置的渠道为准，避免把来源不明的安装包当作通用方案。</p>\n        </details>\n      </div>\n    </section>\n\n    <section class=\"faq-group\">\n      <h3>使用中</h3>\n      <div class=\"faq-list\">\n        <details>\n          <summary>配置后某些平台打不开，先检查什么？</summary>\n          <p>先检查套餐是否包含对应流媒体权益，再检查设备数量是否已经超过参考额度，然后确认配置文件是否由实际渠道给出且版本较新。不同终端、网络环境和平台设置都会影响可访问情况，建议记录异常平台和时间。</p>\n        </details>\n        <details>\n          <summary>多设备同时在线会不会影响使用？</summary>\n          <p>会占用套餐允许的同时在线名额。参考额度为基础版 3 台、旗舰版 5 台、团队版 20 台。如果设备长期挂载但少用，可以暂时离线不常用设备，减少容量压力。</p>\n        </details>\n        <details>\n          <summary>路由器设置比单台设备更复杂吗？</summary>\n          <p>通常更复杂。单台设备只需要当前终端生效，路由器会影响整个局域网，出问题时需要回退普通网络。建议先完成单台设备测试，再考虑路由或共享网络。</p>\n        </details>\n      </div>\n    </section>\n\n    <section class=\"faq-group\">\n      <h3>费用与维护</h3>\n      <div class=\"faq-list\">\n        <details>\n          <summary>年付是否一定比月付划算？</summary>\n          <p>从参考价格看，三档年付都低于对应月付的 12 个月合计：基础版低 30，旗舰版低 70，团队版低 170。是否选择年付取决于你能否确认使用周期和权益一致，不能只看低价。</p>\n        </details>\n        <details>\n          <summary>如果刚开通不确定会不会长期用，怎么办？</summary>\n          <p>先选择月付更稳妥。用完整一周测试主要设备、常用平台和流量强度，再判断基础版是否够用，或者是否需要升级到更高额度套餐。</p>\n        </details>\n        <details>\n          <summary>遇到问题时怎样描述更清楚？</summary>\n          <p>说明套餐档位、设备类型、网络环境、出现问题的平台、发生时间和是否刚更新过配置文件。信息越具体，越容易区分是设备、配置、权益还是渠道支持的问题。</p>\n        </details>\n      </div>\n    </section>\n  </div>\n</section>\n\n<section id=\"notice\" class=\"notice\">\n  <div class=\"notice-inner\">\n    <p class=\"eyebrow\">05 信息边界</p>\n    <h2>本页能说明什么，不能说明什么</h2>\n\n    <ul class=\"notice-list\">\n      <li>已写入：三档参考套餐的月付、年付、流量额度、设备数量、权益、使用步骤、客户端准备清单和常见问题。</li>\n      <li>未写入：官方授权身份、品牌归属、日志政策、退款条款、节点数量、兼容设备完整列表、用户评价和未经确认的下载地址。</li>\n      <li>使用建议：把实际开通页、安装页和正式配置文件作为最终依据；本页用于阅读、比较和准备。</li>\n    </ul>\n\n    <a class=\"back-link\" href=\"#top\">回到首屏</a>\n  </div>\n</section>\n</main>",
